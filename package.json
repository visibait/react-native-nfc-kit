{
  "name": "react-native-nfc-kit",
  "version": "0.0.0",
  "description": "Modern, typed NFC for React Native and Expo. New Architecture native, Swift + Kotlin, sessions that cannot leak.",
  "main": "./build/cjs/index.js",
  "types": "./build/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./ndef": {
      "import": {
        "types": "./build/esm/ndef/index.d.ts",
        "default": "./build/esm/ndef/index.js"
      },
      "require": {
        "types": "./build/cjs/ndef/index.d.ts",
        "default": "./build/cjs/ndef/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "build",
    "plugin/build",
    "ndef",
    "mocks",
    "ios",
    "android",
    "app.plugin.js",
    "expo-module.config.json",
    "ReactNativeNfcKit.podspec",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!ios/build",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.mocks.json && node internal/module_scripts/finalize-build.js && npm run build:plugin",
    "build:plugin": "tsc --build plugin",
    "clean": "node internal/module_scripts/clean.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p plugin --noEmit --composite false && tsc --noEmit -p tsconfig.mocks.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify:package": "node internal/module_scripts/verify-package.js",
    "prepare": "npm run build",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "check:swift": "node internal/module_scripts/check-swift.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "nfc",
    "ndef",
    "mifare",
    "iso7816",
    "iso15693",
    "felica",
    "apdu",
    "hce",
    "corenfc",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visibait/react-native-nfc-kit.git"
  },
  "bugs": {
    "url": "https://github.com/visibait/react-native-nfc-kit/issues"
  },
  "homepage": "https://github.com/visibait/react-native-nfc-kit#readme",
  "author": "visibait",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.4"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-expo": "^57.0.2",
    "expo": "^57.0.21",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "19.2.8",
    "react-native": "0.86.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "module": "./build/esm/index.js"
}
